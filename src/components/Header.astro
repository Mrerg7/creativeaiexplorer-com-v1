---
import { offerHref } from '../config/site';

const nav = [
  { href: '/#current', label: 'Current Landscape' },
  { href: '/#use-cases', label: 'Use Cases' },
  { href: '/#future', label: 'Future' },
  { href: '/#acquire', label: 'Acquire Domain' },
  { href: '/explorations/', label: 'Explorations' },
];
---

<header class="sticky top-0 z-50 border-b border-slate-800/80 bg-slate-950/80 backdrop-blur-xl">
  <div class="container-wide flex h-16 items-center justify-between gap-3">
    <a href="/" class="group flex min-h-12 min-w-0 items-center gap-2.5">
      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-gradient-to-br from-brand-500 to-accent-500 text-sm font-bold text-white shadow-lg shadow-brand-500/30" aria-hidden="true">
        CA
      </span>
      <span class="truncate text-[13px] sm:text-sm font-semibold tracking-tight text-white group-hover:text-brand-300 transition">
        Creative AI Explorer
      </span>
    </a>

    <nav class="hidden md:flex items-center gap-2" aria-label="Primary">
      {nav.map((item) => (
        <a
          href={item.href}
          class="inline-flex min-h-12 items-center px-3 text-sm text-slate-400 hover:text-white transition"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2 shrink-0">
      <a
        href={offerHref}
        class="btn-primary text-xs sm:text-sm !min-h-12 px-4 sm:px-5"
      >
        <span class="sm:hidden">Acquire</span>
        <span class="hidden sm:inline">Acquire Domain</span>
      </a>

      <details class="relative md:hidden">
        <summary
          class="flex min-h-12 min-w-12 cursor-pointer list-none items-center justify-center rounded-lg border border-slate-700 text-slate-200 hover:border-brand-500/50 hover:text-white"
          aria-label="Open menu"
        >
          <span class="sr-only">Menu</span>
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </summary>
        <nav
          class="absolute right-0 mt-2 w-60 rounded-xl border border-slate-800 bg-slate-950 p-2 shadow-xl"
          aria-label="Mobile"
        >
          {nav.map((item) => (
            <a
              href={item.href}
              class="flex min-h-12 items-center rounded-lg px-3 text-sm text-slate-300 hover:bg-slate-900 hover:text-white"
            >
              {item.label}
            </a>
          ))}
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  details summary::-webkit-details-marker {
    display: none;
  }
</style>

<script>
  const closeMenu = (link: HTMLAnchorElement) => {
    link.closest('details')?.removeAttribute('open');
  };
  document.querySelectorAll<HTMLAnchorElement>('header details a').forEach((link) => {
    link.addEventListener('click', () => closeMenu(link));
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      document.querySelectorAll<HTMLDetailsElement>('header details[open]').forEach((menu) => {
        menu.removeAttribute('open');
      });
    }
  });
</script>
