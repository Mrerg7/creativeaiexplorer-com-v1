---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { offerHref } from '../../config/site';

export async function getStaticPaths() {
  const entries = await getCollection('use-cases');
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'use-cases'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const related = (await getCollection('use-cases'))
  .filter((item) => item.slug !== entry.slug)
  .sort((a, b) => {
    const aScore = a.data.category === entry.data.category ? 0 : 1;
    const bScore = b.data.category === entry.data.category ? 0 : 1;
    return aScore - bScore || a.data.order - b.data.order;
  })
  .slice(0, 3);
---

<Layout
  title={entry.data.title}
  description={entry.data.description}
  type="article"
  published={entry.data.published}
>
  <Header />
  <main id="main-content">
    <article class="section-padding">
      <div class="container-narrow max-w-3xl">
        <header class="mb-10">
          <a href="/explorations/" class="inline-flex min-h-12 items-center text-sm text-brand-400 hover:text-brand-300 transition mb-6">
            ← All explorations
          </a>
          <p class="text-xs font-medium uppercase tracking-wider text-brand-400 mb-3">
            {entry.data.category}
          </p>
          <h1 class="text-3xl sm:text-4xl font-bold text-white mb-4 leading-tight">
            {entry.data.title}
          </h1>
          <p class="text-lg text-slate-400 leading-relaxed mb-4">
            {entry.data.description}
          </p>
          <time class="text-sm text-slate-400" datetime={entry.data.published.toISOString()}>
            {entry.data.published.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
        </header>

        <div class="prose prose-invert prose-slate max-w-none
          prose-headings:font-semibold prose-headings:text-white
          prose-p:text-slate-300 prose-p:leading-relaxed
          prose-strong:text-white
          prose-a:text-brand-400 hover:prose-a:text-brand-300
          prose-li:text-slate-300
          prose-ol:text-slate-300
          prose-ul:text-slate-300">
          <Content />
        </div>

        <div class="mt-14 pt-8 border-t border-slate-800">
          <a href="/explorations/" class="btn-secondary text-sm">
            ← Back to explorations
          </a>
        </div>
      </div>
    </article>

    <section class="border-t border-slate-800/60 bg-slate-900/30">
      <div class="container-narrow max-w-3xl py-12">
        <h2 class="text-lg font-semibold text-white mb-4">Keep exploring</h2>
        <ul class="grid gap-3 sm:grid-cols-3">
          {related.map((item) => (
            <li>
              <a
                href={`/explorations/${item.slug}/`}
                class="flex min-h-12 h-full flex-col justify-center rounded-xl border border-slate-800 bg-slate-900/60 px-4 py-3 text-sm text-slate-300 hover:border-brand-500/40 hover:text-white transition"
              >
                {item.data.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="border-t border-slate-800/60">
      <div class="container-narrow max-w-3xl py-12 text-center">
        <p class="text-sm font-semibold uppercase tracking-widest text-brand-400 mb-3">Domain for Sale</p>
        <h2 class="text-xl sm:text-2xl font-bold text-white mb-3 text-balance">
          creativeaiexplorer.com is available for acquisition
        </h2>
        <p class="text-sm text-slate-400 mb-6">
          Priced to sell · Secure escrow transfer · Response within 1–2 business days
        </p>
        <a href={offerHref} class="btn-primary text-sm">Make an offer — sales@desertrich.com</a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
