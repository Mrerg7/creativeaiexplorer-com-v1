---
import { SITE, offerHref } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-slate-800/80 bg-slate-950">
  <!-- Domain Acquisition CTA -->
  <div class="border-b border-slate-800/60">
    <div class="container-narrow section-padding text-center">
      <div class="mx-auto max-w-2xl">
        <p class="text-xs font-semibold uppercase tracking-widest text-brand-400 mb-3">
          Domain Available · Priced to Sell
        </p>
        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-4 text-balance">
          creativeaiexplorer.com is available for acquisition
        </h2>
        <p class="text-slate-400 text-sm sm:text-base leading-relaxed mb-8">
          A clean, memorable exact-match .com positioned at the intersection of creativity and artificial intelligence.
          Ideal for platforms, agencies, research groups, tool builders, or media brands focused on the generative and
          agentic creative economy. Secure escrow transfer, typically completed in 1–5 days.
        </p>
        <a href={offerHref} class="btn-primary text-base px-8 py-3.5">
          Make an offer — sales@desertrich.com
        </a>
        <p class="mt-4 text-xs text-slate-400">
          Serious acquisition inquiries only · Response within 1–2 business days
        </p>
      </div>
    </div>
  </div>

  <!-- Main footer -->
  <div class="container-wide py-10">
    <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-8">
      <div class="max-w-sm">
        <div class="flex items-center gap-2.5 mb-4">
          <span class="flex h-7 w-7 items-center justify-center rounded-md bg-gradient-to-br from-brand-500 to-accent-500 text-xs font-bold text-white" aria-hidden="true">
            CA
          </span>
          <span class="text-sm font-semibold text-white">Creative AI Explorer</span>
        </div>
        <p class="text-sm text-slate-400 leading-relaxed">
          Tracking the tools, workflows, and trajectories shaping creative practice in the age of generative and agentic AI.
        </p>
        <p class="text-sm text-slate-400 leading-relaxed mt-3">
          <strong class="text-slate-300">{SITE.host}</strong> is offered for sale by {SITE.seller}.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 text-sm">
        <div>
          <p class="font-medium text-slate-200 mb-3">Explore</p>
          <ul class="space-y-2 text-slate-400">
            <li><a href="/#current" class="inline-flex min-h-11 items-center hover:text-brand-300 transition">Current Landscape</a></li>
            <li><a href="/#use-cases" class="inline-flex min-h-11 items-center hover:text-brand-300 transition">Use Cases</a></li>
            <li><a href="/#future" class="inline-flex min-h-11 items-center hover:text-brand-300 transition">Future Progress</a></li>
            <li><a href="/explorations/" class="inline-flex min-h-11 items-center hover:text-brand-300 transition">Explorations</a></li>
          </ul>
        </div>
        <div>
          <p class="font-medium text-slate-200 mb-3">Domain</p>
          <ul class="space-y-2 text-slate-400">
            <li>
              <a
                href={offerHref}
                class="inline-flex min-h-11 items-center hover:text-brand-300 transition"
              >
                Acquisition Inquiry
              </a>
            </li>
            <li><a href="/#acquire" class="inline-flex min-h-11 items-center hover:text-brand-300 transition">How to Buy</a></li>
            <li><a href="/#faq" class="inline-flex min-h-11 items-center hover:text-brand-300 transition">Sale FAQ</a></li>
            <li><span class="text-slate-400">{SITE.email}</span></li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Disclaimer -->
    <div class="mt-10 pt-8 border-t border-slate-800/60 pb-24 sm:pb-0">
      <p class="text-xs text-slate-400 leading-relaxed max-w-4xl">
        This website is for demonstration and informational purposes only. It does not constitute an offer of services,
        a commitment to deploy, or a guarantee of outcomes. All statistics, projections, and references to specific
        technologies are based on publicly available information as of the date shown and are subject to change.
      </p>
      <p class="mt-4 text-xs text-slate-400">
        © {year} Creative AI Explorer · Domain for sale: {SITE.host} · Inquiries: <a href={offerHref} class="hover:text-brand-300 transition">{SITE.email}</a>
      </p>
    </div>
  </div>
</footer>

<!-- Sticky mobile acquisition bar -->
<div
  class="sm:hidden fixed inset-x-0 bottom-0 z-40 border-t border-slate-800 bg-slate-950/95 px-4 pt-3 backdrop-blur-xl [padding-bottom:calc(0.75rem+env(safe-area-inset-bottom))]"
>
  <a
    href={offerHref}
    class="btn-primary w-full"
  >
    Acquire this Domain — Make an offer
  </a>
</div>
