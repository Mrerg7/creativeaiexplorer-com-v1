---
const nav = [
  { href: '/#current', label: 'Current Landscape' },
  { href: '/#use-cases', label: 'Use Cases' },
  { href: '/#future', label: 'Future' },
  { href: '/explorations', label: 'Explorations' },
];
---

<header class="sticky top-0 z-50 border-b border-slate-800/80 bg-slate-950/80 backdrop-blur-xl">
  <div class="container-wide flex h-16 items-center justify-between">
    <a href="/" class="group flex items-center gap-2.5">
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-brand-500 to-accent-500 text-sm font-bold text-white shadow-lg shadow-brand-500/30">
        CA
      </span>
      <span class="text-sm font-semibold tracking-tight text-white group-hover:text-brand-300 transition">
        Creative AI Explorer
      </span>
    </a>

    <nav class="hidden md:flex items-center gap-8">
      {nav.map((item) => (
        <a
          href={item.href}
          class="text-sm text-slate-400 hover:text-white transition"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <a
      href="mailto:sales@desertrich.com?subject=Domain%20Acquisition%20Inquiry%20-%20creativeaiexplorer.com"
      class="btn-primary text-xs sm:text-sm px-4 py-2 sm:px-5"
    >
      Acquire Domain
    </a>
  </div>
</header>
