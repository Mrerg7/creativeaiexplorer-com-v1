---
import '../styles/global.css';
import { SITE, canonicalURL as buildCanonical } from '../config/site';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonical?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  published?: Date;
}

const {
  title,
  description,
  ogImage = SITE.ogImage,
  canonical,
  type = 'website',
  noindex = false,
  published,
} = Astro.props;

const siteTitle = SITE.name;
const fullTitle = title === siteTitle ? title : `${title} · ${siteTitle}`;
const canonicalURL = canonical || buildCanonical(Astro.url.pathname);
const robots = noindex
  ? 'noindex, follow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      url: `${SITE.url}/`,
      name: siteTitle,
      description: SITE.description,
      publisher: { '@id': `${SITE.url}/#organization` },
      inLanguage: 'en-US',
    },
    {
      '@type': 'Organization',
      '@id': `${SITE.url}/#organization`,
      name: siteTitle,
      url: `${SITE.url}/`,
      logo: {
        '@type': 'ImageObject',
        url: `${SITE.url}/favicon.svg`,
      },
      contactPoint: {
        '@type': 'ContactPoint',
        email: SITE.email,
        contactType: 'sales',
        areaServed: 'Worldwide',
      },
    },
    {
      '@type': type === 'article' ? 'Article' : 'WebPage',
      '@id': `${canonicalURL}#webpage`,
      url: canonicalURL,
      name: fullTitle,
      description,
      isPartOf: { '@id': `${SITE.url}/#website` },
      inLanguage: 'en-US',
      ...(published
        ? {
            datePublished: published.toISOString(),
            dateModified: published.toISOString(),
          }
        : {}),
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {!noindex && <link rel="canonical" href={canonicalURL} />}
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {noindex && <meta name="googlebot" content="noindex, follow" />}
    <meta name="author" content={siteTitle} />
    <meta name="theme-color" content="#0c4a6e" />
    <meta name="google-site-verification" content="_xWOgHdvINW51ZBl0w8AFz3U5-Fho1N5YzEmwzm8BuE" />

    {!noindex && (
      <>
        <meta property="og:type" content={type} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1366" />
        <meta property="og:image:height" content="745" />
        <meta property="og:site_name" content={siteTitle} />
        <meta property="og:locale" content="en_US" />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={fullTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />

        <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
      </>
    )}

    <link rel="preconnect" href="https://imagedelivery.net" />
    {(Astro.url.pathname === '/' || Astro.url.pathname === '') && (
      <link rel="preload" as="image" href={SITE.heroImage} fetchpriority="high" />
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen flex flex-col overflow-x-hidden">
    <slot />
  </body>
</html>
